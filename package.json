{
  "name": "franchise-management",
  "version": "1.1.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "postinstall": "prisma7 generate",
    "dev": "next dev --turbo",
    "build": "next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma7 generate",
    "prisma:migrate": "prisma7 migrate dev",
    "prisma:migrate:deploy": "prisma7 migrate deploy",
    "prisma:studio": "prisma7 studio",
    "prisma:validate": "prisma7 validate",
    "db:seed": "prisma7 db seed",
    "inventory:audit": "tsx scripts/inventory-audit.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm inventory:audit"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-use-controllable-state": "1.3.0",
    "@rive-app/react-webgl2": "4.41.0",
    "@streamdown/cjk": "1.0.5",
    "@streamdown/code": "2.0.1",
    "@streamdown/math": "1.0.4",
    "@streamdown/mermaid": "1.0.4",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-table": "9.3.1",
    "@xyflow/react": "13.0.3",
    "ai": "7.0.179",
    "ansi-to-react": "^6.2.6",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "dotenv": "18.0.10",
    "embla-carousel-react": "8.6.0",
    "eslint": "^10.15.0",
    "framer-motion": "14.14.0",
    "input-otp": "1.5.0",
    "jose": "6.2.18",
    "lucide-react": "1.78.0",
    "media-chrome": "4.19.5",
    "nanoid": "6.0.2",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-jsx-parser": "2.4.1",
    "react-resizable-panels": "4.24.1",
    "recharts": "3.11.0",
    "shiki": "4.6.0",
    "sonner": "2.0.8",
    "streamdown": "2.8.0",
    "tokenlens": "1.3.1",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@prisma/prisma7": "^7.10.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint-config-next": "16.4.6",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "16.4.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "overrides": {
    "katex": "^0.18.2",
    "effect": "^3.22.1",
    "linkify-it": "^5.0.2",
    "minimatch": "^11.0.1"
  }
}
