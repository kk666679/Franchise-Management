generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum BrandStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum FranchiseeStatus {
  PROSPECT
  ACTIVE
  ON_HOLD
  EXITED
}

enum LocationStatus {
  PLANNING
  ACTIVE
  TEMPORARILY_CLOSED
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AgreementStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  DIRECT_DEBIT
  OTHER
}

enum DocumentType {
  APPLICATION
  AGREEMENT
  LICENSE
  INSURANCE
  FINANCIAL
  TAX
  COMPLIANCE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE
  EXPORT
}

enum GeoEntitySource {
  MANUAL
  IMPORT_GEOJSON
  IMPORT_KML
  IMPORT_GPX
  IMPORT_WKT
  IMPORT_CSV
  IMPORT_OSM
  API
  SYSTEM
}

enum GeoTerritoryType {
  EXCLUSIVE
  NON_EXCLUSIVE
  RESTRICTED_DEVELOPMENT
  PROTECTED
  EXPANSION_OPPORTUNITY
}

enum GeoTerritoryStatus {
  DRAFT
  ACTIVE
  PENDING
  EXPIRED
  ARCHIVED
}

enum GeoImportStatus {
  PENDING
  VALIDATING
  VALIDATED
  IMPORTED
  FAILED
}

enum GeoLocationType {
  HEADQUARTERS
  REGIONAL_OFFICE
  MASTER_FRANCHISE_OFFICE
  FRANCHISE_OUTLET
  COMPANY_OWNED_OUTLET
  SUB_FRANCHISE_OUTLET
  DISTRIBUTION_CENTRE
  WAREHOUSE
  SERVICE_CENTRE
  PLANNED_LOCATION
  CLOSED_LOCATION
}

enum FinancialAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FinancialAccountStatus {
  ACTIVE
  INACTIVE
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalEntrySource {
  MANUAL
  INVOICE
  PAYMENT
  SALE
  REFUND
  ADJUSTMENT
}

enum PaymentAllocationStatus {
  UNALLOCATED
  PARTIALLY_ALLOCATED
  ALLOCATED
}

enum BankReconciliationStatus {
  UNMATCHED
  MATCHED
  EXCLUDED
}

enum SalesQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SalesReturnStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum POSShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  FLOAT
  CASH_IN
  CASH_OUT
  CASH_DROP
  ADJUSTMENT
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  websiteUrl  String?
  timezone    String   @default("UTC")
  currency    String   @default("USD") @db.VarChar(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships        Membership[]
  brands             FranchiseBrand[]
  feeSchedules       FeeSchedule[]
  franchisees        Franchisee[]
  locations          FranchiseLocation[]
  applications       FranchiseApplication[]
  agreements         FranchiseAgreement[]
  invoices           Invoice[]
  payments           Payment[]
  documents          Document[]
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]
  financialAccounts  FinancialAccount[]
  financialPeriods   FinancialPeriod[]
  journalEntries     JournalEntry[]
  bankAccounts       BankAccount[]
  paymentAllocations PaymentAllocation[]
  customers          Customer[]
  products           Product[]
  salesQuotations    SalesQuotation[]
  salesOrders        SalesOrder[]
  salesInvoices      SalesInvoice[]
  promotions         Promotion[]
  sales              Sale[]
  posTerminals       PosTerminal[]
  cashierShifts      CashierShift[]
  salesReturns       SalesReturn[]
  refunds            Refund[]
  geoTerritories     GeoTerritory[]
  geoTerritoryAssignments GeoTerritoryAssignment[]
  geoFeatureRecords  GeoFeatureRecord[]
  geoImportJobs      GeoImportJob[]
  geoValidationErrors GeoValidationError[]
  geoAnalysisResults GeoAnalysisResult[]
  geoAuditLogs       GeoAuditLog[]
  geoDataSources     GeoDataSource[]

  @@index([slug])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  phone        String?
  avatarUrl    String?
  passwordHash String?
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships           Membership[]
  magicLinkTokens       MagicLinkToken[]
  submittedApplications FranchiseApplication[] @relation("ApplicationSubmitter")
  uploadedDocuments     Document[]             @relation("DocumentUploader")
  createdTickets        SupportTicket[]        @relation("TicketCreator")
  assignedTickets       SupportTicket[]        @relation("TicketAssignee")
  cashierShifts         CashierShift[]         @relation("CashierShifts")
  auditLogs             AuditLog[]

  @@index([status])
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(STAFF)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model MagicLinkToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model FranchiseBrand {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  status         BrandStatus @default(DRAFT)
  foundedYear    Int?
  websiteUrl     String?
  logoUrl        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications FranchiseApplication[]
  agreements   FranchiseAgreement[]
  franchisees  Franchisee[]
  locations    FranchiseLocation[]
  feeSchedules FeeSchedule[]
  documents    Document[]
  geoTerritories GeoTerritory[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model Franchisee {
  id             String           @id @default(cuid())
  organizationId String
  brandId        String?
  legalName      String
  tradingName    String?
  registrationNo String?
  taxId          String?
  email          String?
  phone          String?
  status         FranchiseeStatus @default(PROSPECT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        FranchiseBrand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  contacts     FranchiseeContact[]
  applications FranchiseApplication[]
  agreements   FranchiseAgreement[]
  locations    FranchiseLocation[]
  invoices     Invoice[]
  tickets      SupportTicket[]
  documents    Document[]
  geoTerritoryAssignments GeoTerritoryAssignment[]

  @@unique([organizationId, registrationNo])
  @@index([organizationId, status])
  @@index([brandId])
}

model FranchiseeContact {
  id           String   @id @default(cuid())
  franchiseeId String
  name         String
  email        String?
  phone        String?
  title        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  franchisee Franchisee @relation(fields: [franchiseeId], references: [id], onDelete: Cascade)

  @@index([franchiseeId, isPrimary])
}

model FranchiseLocation {
  id             String         @id @default(cuid())
  organizationId String
  brandId        String
  franchiseeId   String?
  name           String
  code           String
  status         LocationStatus @default(PLANNING)
  addressLine1   String
  addressLine2   String?
  city           String
  state          String?
  postalCode     String
  country        String         @default("US")
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  openedAt       DateTime?
  closedAt       DateTime?
  // Geo intelligence fields
  locationType          GeoLocationType @default(FRANCHISE_OUTLET)
  ownershipType         String?
  businessStatus        String?
  district              String?
  geoPoint              Unsupported("geometry(Point,4326)")?
  contactInfo           Json?
  operatingHours        Json?
  assignedTerritoryId   String?
  assignedFranchiseeId  String?
  storeSize             Decimal?        @db.Decimal(10, 2)
  parkingAvailability   Boolean?
  propertyType          String?
  rentalInformation     Json?
  supportingDocuments   Json?
  photos                Json?
  geoSource             GeoEntitySource @default(MANUAL)
  geoVersion            Int             @default(1)
  geoMetadata           Json?
  createdById           String?
  updatedById           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand             FranchiseBrand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  franchisee        Franchisee?          @relation(fields: [franchiseeId], references: [id], onDelete: SetNull)
  assignedTerritory GeoTerritory?        @relation("LocationAssignedTerritory", fields: [assignedTerritoryId], references: [id], onDelete: SetNull)
  agreements        FranchiseAgreement[]
  documents         Document[]
  tickets           SupportTicket[]

  @@unique([organizationId, code])
  @@index([brandId, status])
  @@index([franchiseeId])
  @@index([assignedTerritoryId])
  @@index([locationType])
}

model FranchiseApplication {
  id             String            @id @default(cuid())
  organizationId String
  brandId        String
  franchiseeId   String?
  submittedById  String?
  status         ApplicationStatus @default(DRAFT)
  referenceNo    String
  submittedAt    DateTime?
  reviewedAt     DateTime?
  decisionNotes  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        FranchiseBrand      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  franchisee   Franchisee?         @relation(fields: [franchiseeId], references: [id], onDelete: SetNull)
  submittedBy  User?               @relation("ApplicationSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  agreement    FranchiseAgreement?
  documents    Document[]

  @@unique([organizationId, referenceNo])
  @@index([organizationId, status])
  @@index([brandId, status])
}

model FranchiseAgreement {
  id             String          @id @default(cuid())
  organizationId String
  brandId        String
  franchiseeId   String
  locationId     String?
  applicationId  String?         @unique
  agreementNo    String
  status         AgreementStatus @default(DRAFT)
  signedAt       DateTime?
  startDate      DateTime
  endDate        DateTime?
  renewalDate    DateTime?
  initialFee     Decimal         @db.Decimal(12, 2)
  royaltyRate    Decimal         @db.Decimal(5, 2)
  marketingRate  Decimal         @default(0) @db.Decimal(5, 2)
  terms          Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        FranchiseBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  franchisee   Franchisee            @relation(fields: [franchiseeId], references: [id], onDelete: Restrict)
  location     FranchiseLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  application  FranchiseApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  invoices     Invoice[]
  documents    Document[]

  @@unique([organizationId, agreementNo])
  @@index([franchiseeId, status])
  @@index([brandId, status])
  @@index([endDate])
}

model FeeSchedule {
  id             String   @id @default(cuid())
  organizationId String
  brandId        String
  name           String
  description    String?
  initialFee     Decimal  @default(0) @db.Decimal(12, 2)
  royaltyRate    Decimal  @default(0) @db.Decimal(5, 2)
  marketingRate  Decimal  @default(0) @db.Decimal(5, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        FranchiseBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId, brandId, active])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  franchiseeId   String
  agreementId    String?
  invoiceNo      String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  franchisee         Franchisee          @relation(fields: [franchiseeId], references: [id], onDelete: Restrict)
  agreement          FranchiseAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  lines              InvoiceLine[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]

  @@unique([organizationId, invoiceNo])
  @@index([franchiseeId, status])
  @@index([dueDate, status])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  reference      String?
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  provider       String?
  providerRef    String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]

  @@unique([provider, providerRef])
  @@unique([organizationId, provider, providerRef])
  @@index([invoiceId, status])
  @@index([organizationId, paidAt])
}

model FinancialAccount {
  id             String                 @id @default(cuid())
  organizationId String
  parentId       String?
  code           String
  name           String
  type           FinancialAccountType
  status         FinancialAccountStatus @default(ACTIVE)
  currency       String                 @default("USD") @db.VarChar(3)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       FinancialAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     FinancialAccount[] @relation("AccountHierarchy")
  journalLines JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId, type, status])
  @@index([parentId])
}

model FinancialPeriod {
  id             String                @id @default(cuid())
  organizationId String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  status         FinancialPeriodStatus @default(OPEN)
  closedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([organizationId, name])
  @@index([organizationId, startsAt, endsAt])
}

model JournalEntry {
  id             String             @id @default(cuid())
  organizationId String
  periodId       String
  entryNo        String
  status         JournalEntryStatus @default(DRAFT)
  source         JournalEntrySource
  sourceId       String?
  idempotencyKey String?
  description    String
  postedAt       DateTime?
  reversedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period       FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines        JournalLine[]

  @@unique([organizationId, entryNo])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, postedAt])
  @@index([source, sourceId])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  referenceType  String?
  referenceId    String?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
}

model PaymentAllocation {
  id             String   @id @default(cuid())
  organizationId String
  paymentId      String
  invoiceId      String
  idempotencyKey String?
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, invoiceId])
}

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  accountNumber  String?
  currency       String   @default("USD") @db.VarChar(3)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([organizationId, active])
}

model BankTransaction {
  id              String                   @id @default(cuid())
  bankAccountId   String
  externalId      String?
  reference       String?
  amount          Decimal                  @db.Decimal(18, 2)
  transactionDate DateTime
  status          BankReconciliationStatus @default(UNMATCHED)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, externalId])
  @@index([bankAccountId, transactionDate, status])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  customerNo     String
  name           String
  email          String?
  phone          String?
  taxId          String?
  address        Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotations   SalesQuotation[]
  orders       SalesOrder[]
  invoices     SalesInvoice[]
  sales        Sale[]
  returns      SalesReturn[]

  @@unique([organizationId, customerNo])
  @@index([organizationId, name])
  @@index([organizationId, email])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  barcode        String?
  name           String
  description    String?
  unitPrice      Decimal  @db.Decimal(18, 2)
  costPrice      Decimal  @default(0) @db.Decimal(18, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteLines   SalesQuotationLine[]
  orderLines   SalesOrderLine[]
  invoiceLines SalesInvoiceLine[]
  saleLines    SaleLine[]
  returnLines  SalesReturnLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, name])
  @@index([organizationId, active])
}

model SalesQuotation {
  id             String           @id @default(cuid())
  organizationId String
  customerId     String
  quoteNo        String
  status         SalesQuoteStatus @default(DRAFT)
  issueDate      DateTime         @default(now())
  validUntil     DateTime?
  subtotal       Decimal          @db.Decimal(18, 2)
  discount       Decimal          @default(0) @db.Decimal(18, 2)
  tax            Decimal          @default(0) @db.Decimal(18, 2)
  total          Decimal          @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines        SalesQuotationLine[]
  orders       SalesOrder[]

  @@unique([organizationId, quoteNo])
  @@index([organizationId, status])
}

model SalesQuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  productId   String
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  tax         Decimal @default(0) @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
}

model SalesOrder {
  id             String           @id @default(cuid())
  organizationId String
  customerId     String
  quotationId    String?
  orderNo        String
  status         SalesOrderStatus @default(DRAFT)
  orderDate      DateTime         @default(now())
  subtotal       Decimal          @db.Decimal(18, 2)
  discount       Decimal          @default(0) @db.Decimal(18, 2)
  tax            Decimal          @default(0) @db.Decimal(18, 2)
  total          Decimal          @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation    SalesQuotation?  @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  lines        SalesOrderLine[]
  invoices     SalesInvoice[]

  @@unique([organizationId, orderNo])
  @@index([organizationId, status])
}

model SalesOrderLine {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  tax         Decimal @default(0) @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model SalesInvoice {
  id             String             @id @default(cuid())
  organizationId String
  customerId     String
  orderId        String?
  invoiceNo      String
  status         SalesInvoiceStatus @default(DRAFT)
  issueDate      DateTime           @default(now())
  dueDate        DateTime?
  subtotal       Decimal            @db.Decimal(18, 2)
  discount       Decimal            @default(0) @db.Decimal(18, 2)
  tax            Decimal            @default(0) @db.Decimal(18, 2)
  total          Decimal            @db.Decimal(18, 2)
  amountPaid     Decimal            @default(0) @db.Decimal(18, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order        SalesOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines        SalesInvoiceLine[]
  payments     SalePayment[]

  @@unique([organizationId, invoiceNo])
  @@index([organizationId, status])
}

model SalesInvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  tax         Decimal @default(0) @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model Promotion {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           DiscountType
  value          Decimal      @db.Decimal(18, 2)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model PosTerminal {
  id             String   @id @default(cuid())
  organizationId String
  locationId     String?
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shifts       CashierShift[]
  sales        Sale[]

  @@unique([organizationId, code])
  @@index([organizationId, active])

  @@map("POSTerminal")
}

model CashierShift {
  id             String         @id @default(cuid())
  organizationId String
  terminalId     String
  cashierId      String
  status         POSShiftStatus @default(OPEN)
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  openingFloat   Decimal        @db.Decimal(18, 2)
  expectedCash   Decimal?       @db.Decimal(18, 2)
  countedCash    Decimal?       @db.Decimal(18, 2)
  variance       Decimal?       @db.Decimal(18, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terminal     PosTerminal    @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  cashier      User           @relation("CashierShifts", fields: [cashierId], references: [id], onDelete: Restrict)
  sales        Sale[]
  movements    CashMovement[]

  @@index([organizationId, status])
  @@index([terminalId, openedAt])
}

model Sale {
  id             String     @id @default(cuid())
  organizationId String
  customerId     String?
  terminalId     String?
  shiftId        String?
  promotionId    String?
  receiptNo      String
  idempotencyKey String?
  status         SaleStatus @default(COMPLETED)
  soldAt         DateTime   @default(now())
  subtotal       Decimal    @db.Decimal(18, 2)
  discount       Decimal    @default(0) @db.Decimal(18, 2)
  tax            Decimal    @default(0) @db.Decimal(18, 2)
  total          Decimal    @db.Decimal(18, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  terminal     PosTerminal?  @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  shift        CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  promotion    Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  lines        SaleLine[]
  payments     SalePayment[]
  returns      SalesReturn[]
  refunds      Refund[]

  @@unique([organizationId, receiptNo])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, soldAt])
  @@index([organizationId, status])
}

model SaleLine {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  tax         Decimal @default(0) @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
}

model SalePayment {
  id          String        @id @default(cuid())
  saleId      String?
  invoiceId   String?
  method      PaymentMethod
  amount      Decimal       @db.Decimal(18, 2)
  reference   String?
  status      PaymentStatus @default(SUCCEEDED)
  providerRef String?
  paidAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())

  sale    Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  invoice SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([saleId, status])
  @@index([invoiceId, status])
}

model SalesReturn {
  id             String            @id @default(cuid())
  organizationId String
  saleId         String
  customerId     String?
  returnNo       String
  status         SalesReturnStatus @default(REQUESTED)
  reason         String?
  total          Decimal           @db.Decimal(18, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines        SalesReturnLine[]
  refunds      Refund[]

  @@unique([organizationId, returnNo])
  @@index([organizationId, status])
}

model SalesReturnLine {
  id          String  @id @default(cuid())
  returnId    String
  productId   String
  description String
  quantity    Decimal @db.Decimal(18, 3)
  amount      Decimal @db.Decimal(18, 2)

  return  SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnId])
}

model Refund {
  id             String        @id @default(cuid())
  organizationId String
  saleId         String?
  returnId       String?
  amount         Decimal       @db.Decimal(18, 2)
  method         PaymentMethod
  status         RefundStatus  @default(PENDING)
  idempotencyKey String?
  reference      String?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  return       SalesReturn? @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
}

model CashMovement {
  id        String           @id @default(cuid())
  shiftId   String
  type      CashMovementType
  amount    Decimal          @db.Decimal(18, 2)
  reference String?
  createdAt DateTime         @default(now())

  shift CashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, createdAt])
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  brandId        String?
  franchiseeId   String?
  locationId     String?
  applicationId  String?
  agreementId    String?
  uploadedById   String?
  type           DocumentType
  name           String
  storageKey     String       @unique
  contentType    String?
  sizeBytes      BigInt?
  checksum       String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        FranchiseBrand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  franchisee   Franchisee?           @relation(fields: [franchiseeId], references: [id], onDelete: SetNull)
  location     FranchiseLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  application  FranchiseApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  agreement    FranchiseAgreement?   @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  uploadedBy   User?                 @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId, type])
  @@index([franchiseeId])
  @@index([expiresAt])
}

model SupportTicket {
  id             String         @id @default(cuid())
  organizationId String
  franchiseeId   String?
  locationId     String?
  createdById    String
  assignedToId   String?
  subject        String
  description    String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  franchisee   Franchisee?        @relation(fields: [franchiseeId], references: [id], onDelete: SetNull)
  location     FranchiseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy    User               @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo   User?              @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, priority])
  @@index([assignedToId, status])
  @@index([franchiseeId])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String?
  action         AuditAction
  entity         String
  entityId       String
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}


enum TerritoryType {
  EXCLUSIVE
  NON_EXCLUSIVE
  RESTRICTED_DEVELOPMENT
  PROTECTED
  EXPANSION_OPPORTUNITY
}

enum TerritoryStatus {
  DRAFT
  ACTIVE
  PENDING
  EXPIRED
  ARCHIVED
}



model GeoTerritory {
  id                        String             @id @default(cuid())
  organizationId            String
  name                      String
  territoryCode             String
  parentTerritoryId         String?
  country                   String?
  state                     String?
  district                  String?
  territoryOwner            String?
  assignedMasterFranchiseId String?
  assignedRegionalManagerId String?
  territoryType             GeoTerritoryType   @default(NON_EXCLUSIVE)
  exclusivityStatus         String             @default("NON_EXCLUSIVE")
  effectiveDate             DateTime?
  expiryDate                DateTime?
  status                    GeoTerritoryStatus @default(DRAFT)
  geometry                  Unsupported("geometry(MultiPolygon,4326)")
  areaSqKm                  Decimal?           @db.Decimal(14, 4)
  perimeterKm               Decimal?           @db.Decimal(14, 4)
  centroidLat               Decimal?           @db.Decimal(9, 6)
  centroidLng               Decimal?           @db.Decimal(9, 6)
  populationEstimate        Int?
  existingOutletCount       Int                @default(0)
  plannedOutletCount        Int                @default(0)
  brandId                   String?
  source                    GeoEntitySource    @default(MANUAL)
  version                   Int                @default(1)
  metadata                  Json?
  allowedOverlapSqM         Decimal?           @db.Decimal(14, 2)
  approvedOverlapIds        Json?
  createdById               String?
  updatedById               String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        FranchiseBrand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  parent       GeoTerritory?             @relation("TerritoryHierarchy", fields: [parentTerritoryId], references: [id], onDelete: SetNull)
  children     GeoTerritory[]            @relation("TerritoryHierarchy")
  assignments  GeoTerritoryAssignment[]
  locations    FranchiseLocation[]       @relation("LocationAssignedTerritory")

  @@unique([organizationId, territoryCode])
  @@index([organizationId, status])
  @@index([brandId])
  @@index([parentTerritoryId])
}

model GeoTerritoryAssignment {
  id             String   @id @default(cuid())
  organizationId String
  territoryId    String
  franchiseeId   String?
  userId         String?
  role           String?
  assignedAt     DateTime @default(now())
  unassignedAt   DateTime?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  territory    GeoTerritory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  franchisee   Franchisee?  @relation(fields: [franchiseeId], references: [id], onDelete: SetNull)

  @@index([organizationId, territoryId])
  @@index([franchiseeId])
}

model GeoFeatureRecord {
  id             String          @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String?
  geometry       Unsupported("geometry(Geometry,4326)")
  properties     Json?
  source         GeoEntitySource @default(MANUAL)
  metadata       Json?
  version        Int             @default(1)
  createdById    String?
  updatedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType])
  @@index([entityId])
}

model GeoImportJob {
  id             String          @id @default(cuid())
  organizationId String
  fileName       String
  format         String
  status         GeoImportStatus @default(PENDING)
  totalFeatures  Int             @default(0)
  validFeatures  Int             @default(0)
  invalidFeatures Int            @default(0)
  importedCount  Int             @default(0)
  duplicateCount Int             @default(0)
  errors         Json?
  warnings       Json?
  report         Json?
  source         String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  validationErrors GeoValidationError[]

  @@index([organizationId, createdAt])
  @@index([status])
}

model GeoValidationError {
  id             String   @id @default(cuid())
  organizationId String
  importJobId    String?
  entityType     String?
  entityId       String?
  code           String
  message        String
  path           String?
  severity       String   @default("error")
  raw            Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importJob    GeoImportJob? @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([importJobId])
}

model GeoAnalysisResult {
  id             String   @id @default(cuid())
  organizationId String
  analysisType   String
  input          Json?
  result         Json
  summary        Json?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, analysisType, createdAt])
}

model GeoAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  action         String
  actorId        String?
  actorName      String?
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model GeoDataSource {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sourceType     String
  config         Json?
  attribution    String?
  lastFetchedAt  DateTime?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sourceType])
}
